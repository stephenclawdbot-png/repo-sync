{
  "scan_paths": [
    "/Users/clawdbot/.openclaw/workspace"
  ],
  "exclude_patterns": [
    "node_modules",
    ".venv",
    "venv",
    "__pycache__",
    ".pytest_cache",
    ".git",
    "target",
    "dist",
    "build",
    ".idea",
    ".vscode",
    "REPO-SYNC"
  ],
  "repos": {},
  "auto_commit": {
    "enabled": false,
    "idle_minutes": 5,
    "auto_push": false,
    "include_patterns": [
      "*.py",
      "*.js",
      "*.ts",
      "*.md",
      "*.json",
      "*.yaml",
      "*.yml",
      "*.toml",
      "*.txt",
      "*.rs",
      "*.go"
    ],
    "exclude_patterns": [
      "*.log",
      "*.tmp",
      "*.cache",
      ".env*",
      "secrets*",
      "*.key"
    ]
  },
  "commit_message_style": "conventional",
  "dashboard": {
    "title": "REPO-SYNC Dashboard",
    "refresh_interval_seconds": 30,
    "theme": "dark"
  }
}
